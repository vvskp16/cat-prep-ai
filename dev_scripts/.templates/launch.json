{
    "configurations": [
        {
            "name": "Debug CAT Prep AI Python App",
            "type": "debugpy",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "ROOT_DIR": "${workspaceFolder}",
                "AUTHORIZATION_STRATEGY": "JWT",
                "HEART_BEAT_INTERVAL": "30000",
                "LOG_LEVEL": "DEBUG"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}